# Chain to target. Defaults to studionet if unset. One of:
# studionet | localnet | testnetAsimov | testnetBradbury
NEXT_PUBLIC_GENLAYER_CHAIN=studionet

# OriginalStake contract address on the chain above. Leave blank until
# you've deployed the contract in project-2/contract/originalstake.py — the
# app renders a clean "no contract configured" empty state everywhere while
# this is unset, rather than faking data.
NEXT_PUBLIC_GENLAYER_CONTRACT_ADDRESS=
